# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Project artifacts
logs/*.log
# 预标注复核 overlay（tools/ingest_raw_imgs.py 产出）。
# 注意注释必须独占一行：gitignore 不认行尾 # 注释，写成
# `logs/review/  # 说明` 会把整行当模式，等于这条忽略从未生效。
logs/review/
# 实机预览标注帧（tools/annotate_live.py 的 --save / 按 s 产出），是生成物。
logs/annotate/
recordings/
templates/*.png
!templates/.gitkeep
!templates/manifest.yaml

# YOLO auto-labeling output (generated by tools/auto_label_yolo.py)
dataset/
runs/

# Hand-recorded screenshots awaiting ingest (see raw_imgs/README.md).
# Screenshots are large; only the README is versioned.
raw_imgs/*
!raw_imgs/README.md

# ultralytics 按 cwd 解析数据集路径时误落地的 COCO 下载（5.2 GB，非本项目数据）
/rok_assistant/
# 本地代码索引（CodeGraph）
.codegraph/
# YOLO 预训练基线权重：本地起训用，不入库（训完的权重在 runs/，本就被忽略）
*.pt

# Test fixtures are committed to the repo (test assets, not transient artifacts)

# pytest transient dirs (pyproject pins --basetemp)
.pytest_tmp/
tmp_pytest/

# User config (example is committed)
config.yaml

# IDE
.idea/
.vscode/

# superpowers skill working dirs
.superpowers/
